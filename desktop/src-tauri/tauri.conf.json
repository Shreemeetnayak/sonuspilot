{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonusPilot",
  "version": "0.2.0",
  "identifier": "com.sonuspilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SonusPilot",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Adaptive system-wide EQ for Windows",
    "longDescription": "SonusPilot reads the currently playing track from Windows, resolves a reference curve for its genre, applies headphone correction where a measurement profile exists, and writes the result to Equalizer APO as a 31-band graphic EQ.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
